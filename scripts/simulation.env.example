# Copy to .env.simulation at repository root. Use a dedicated local/staging test club.
# No service-role key is needed in this file. The running app has its own server env.
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=your-local-or-staging-anon-key
SIM_APP_URL=http://localhost:5173
SIM_CLUB_ID=your-test-club-uuid
SIM_ADMIN_EMAIL=your-dedicated-test-admin@example.com
SIM_ADMIN_PASSWORD=your-test-admin-password
# The club name must begin [SIM], its entire roster must have [SIM] names,
# and it must not already have a live session.
SIM_ALLOW_DATABASE_WRITES=false
