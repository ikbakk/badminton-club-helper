PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never use this as a PUBLIC_ variable or expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Remote integration tests are opt-in and must only point to the dedicated staging project.
RUN_STAGING_TESTS=false
STAGING_SUPABASE_URL=https://your-staging-project-ref.supabase.co
STAGING_PROJECT_REF=your-staging-project-ref
PRODUCTION_PROJECT_REF=your-production-project-ref
STAGING_SUPABASE_ANON_KEY=your-staging-anon-key
# Server-side test credential; keep local and out of PUBLIC_ variables.
STAGING_SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
STAGING_TEST_PASSWORD=replace-with-a-unique-test-password
STAGING_APP_URL=https://your-preview.vercel.app
